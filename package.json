{
  "name": "vite-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sink": "node src/lib/satisfactory-sink/cli.ts",
    "test": "node --test \"src/lib/**/*.test.ts\"",
    "test:sink": "node --test \"src/lib/satisfactory-sink/*.test.ts\"",
    "check:env": "node scripts/check-env.ts",
    "verify": "npm run lint && npm run check:env && npm run test && npm run data:satisfactory:check && npm run build",
    "data:satisfactory": "node scripts/build-satisfactory-data.ts",
    "data:satisfactory:check": "node scripts/build-satisfactory-data.ts --check"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.13",
    "firebase": "^12.9.0",
    "jquery": "^4.0.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.9",
    "popper.js": "^1.16.1",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
