{
  "name": "vite-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sink": "node src/lib/satisfactory-sink/cli.ts",
    "test": "node --test \"src/lib/**/*.test.ts\"",
    "test:sink": "node --test \"src/lib/satisfactory-sink/*.test.ts\"",
    "check:env": "node scripts/check-env.ts",
    "verify": "npm run lint && npm run check:env && npm run test && npm run test:ui && npm run data:satisfactory:check && npm run build",
    "data:satisfactory": "node scripts/build-satisfactory-data.ts",
    "data:satisfactory:check": "node scripts/build-satisfactory-data.ts --check",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.16",
    "firebase": "^12.19.0",
    "jquery": "^4.0.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.14",
    "popper.js": "^1.16.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
